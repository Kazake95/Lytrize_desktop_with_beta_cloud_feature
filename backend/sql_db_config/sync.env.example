# Lytrize Supabase Sync Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to:  ~/.local/share/lytrize/sync.env
# Then fill in your Supabase project URL and public anon key.
#
# You do NOT need a PostgreSQL connection string for Lytrize desktop sync.
# Use the public project URL and the public anon key from the Supabase dashboard.
#
# LYTRIZE_SUPABASE_URL should be the public Supabase project URL, e.g.:
#   https://YOUR-PROJECT-REF.supabase.co
#
# LYTRIZE_SUPABASE_ANON_KEY is the public anon key from the Supabase dashboard.
# These are public client-side values; do NOT put a PostgreSQL password here.
#
LYTRIZE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
LYTRIZE_SUPABASE_ANON_KEY=your-anon-key-here
